# ===================================================
# Autonomous Outreach Engine Configuration
# ===================================================

# Database Configuration
DATABASE_URL=postgresql+asyncpg://outreach_user:outreach_password@localhost:5432/outreach_crm
DATABASE_SYNC_URL=postgresql://outreach_user:outreach_password@localhost:5432/outreach_crm

# ===================================================
# Free-Tier LLM Providers (Pick any or all for auto-fallback)
# ===================================================
# 1. OpenRouter (Free tier models: meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Groq (Ultra-fast free rate limits: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b)
GROQ_API_KEY=your_groq_api_key_here

# 3. NVIDIA NIM Free Tier (meta/llama-3.3-70b-instruct, mistralai/mistral-large-2-instruct)
NVIDIA_API_KEY=your_nvidia_api_key_here

# 4. Google Gemini Free Tier (gemini-2.0-flash, gemini-1.5-flash)
GOOGLE_API_KEY=your_google_api_key_here

# 5. Local Ollama (Zero cost, runs on localhost)
OLLAMA_BASE_URL=http://localhost:11434/v1

# 6. Custom OpenAI-compatible Base URL
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Default provider & free model
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ===================================================
# Telegram Bot Alerts & Interactive HITL
# ===================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===================================================
# Outbound Email & Sending Limits (Secondary Domain)
# ===================================================
OUTBOUND_SECONDARY_DOMAIN=yourname-labs.com
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=outreach@yourname-labs.com
SMTP_PASSWORD=your_smtp_password
DAILY_EMAIL_LIMIT=25

# ===================================================
# IMAP / Incoming Reply Monitoring
# ===================================================
IMAP_HOST=imap.mailgun.org
IMAP_PORT=993
IMAP_USER=outreach@yourname-labs.com
IMAP_PASSWORD=your_imap_password

# ===================================================
# Bounded Negotiation Guardrails
# ===================================================
MINIMUM_ACCEPTABLE_RATE_HOURLY=150
MINIMUM_ACCEPTABLE_FIXED_PROJECT=5000
MAX_DISCOUNT_PERCENTAGE=10
MILESTONE_TERMS="50% upfront deposit, 50% upon milestone completion"
