# ==========================================
# Autonomous Outreach Engine Configuration
# ==========================================

# Database Configuration
DATABASE_URL=postgresql+asyncpg://outreach_user:outreach_password@localhost:5432/outreach_crm
DATABASE_SYNC_URL=postgresql://outreach_user:outreach_password@localhost:5432/outreach_crm

# LLM Providers (OpenAI, Anthropic, or Gemini)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

# Telegram Bot Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Outbound Email & Sending Limits
OUTBOUND_SECONDARY_DOMAIN=yourname-labs.com
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=outreach@yourname-labs.com
SMTP_PASSWORD=your_smtp_password
DAILY_EMAIL_LIMIT=25

# IMAP / Incoming Reply Monitoring
IMAP_HOST=imap.mailgun.org
IMAP_PORT=993
IMAP_USER=outreach@yourname-labs.com
IMAP_PASSWORD=your_imap_password

# Bounded Negotiation Guardrails
MINIMUM_ACCEPTABLE_RATE_HOURLY=150
MINIMUM_ACCEPTABLE_FIXED_PROJECT=5000
MAX_DISCOUNT_PERCENTAGE=10
MILESTONE_TERMS="50% upfront, 50% upon milestone completion"
